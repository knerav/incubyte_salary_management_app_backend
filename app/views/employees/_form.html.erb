<%= form_with model: employee, class: "space-y-5" do |f| %>
  <% if employee.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3">
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% employee.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-5">
    <div>
      <%= f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :first_name,
            class: "w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :last_name,
            class: "w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.email_field :email,
          class: "w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :job_title_id, "Job Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :job_title_id, JobTitle.order(:name), :id, :name,
          { prompt: "Select a job title" },
          class: "w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
  </div>

  <div class="grid grid-cols-2 gap-5">
    <div>
      <%= f.label :department, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :department,
            class: "w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :country, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :country, maxlength: 2, placeholder: "e.g. US",
            class: "w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>
  </div>

  <div>
    <%= f.label :employment_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :employment_type,
          Employee::EMPLOYMENT_TYPES.map { |t| [t.humanize, t] },
          { prompt: "Select employment type" },
          class: "w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
  </div>

  <div>
    <%= f.label :hired_on, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :hired_on,
          class: "w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 cursor-pointer transition-colors" %>
    <%= link_to "Cancel", employees_path, class: "text-sm text-gray-600 hover:text-gray-500" %>
  </div>
<% end %>
