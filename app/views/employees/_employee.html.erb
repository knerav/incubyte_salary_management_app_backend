<div id="<%= dom_id(employee) %>" class="flex items-center justify-between px-6 py-4">
  <div>
    <p class="text-sm font-medium text-gray-900">
      <%= link_to employee.full_name, employee_path(employee),
            class: "hover:text-indigo-600" %>
    </p>
    <p class="text-xs text-gray-500"><%= employee.job_title.name %> · <%= employee.department.name %></p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to "Edit", edit_employee_path(employee),
          class: "text-sm text-indigo-600 hover:text-indigo-500 font-medium" %>
    <%= button_to "Delete", employee_path(employee),
          method: :delete,
          class: "text-sm text-red-600 hover:text-red-500 font-medium bg-transparent border-0 cursor-pointer p-0",
          data: { turbo_confirm: "Delete #{employee.full_name}? This cannot be undone." } %>
  </div>
</div>
