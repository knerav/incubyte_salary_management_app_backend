<div class="max-w-6xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-neutral-900">Employees</h1>
    <%= link_to new_employee_path,
          data: { turbo_frame: "modal" },
          class: "rounded-lg bg-amber-700 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600 transition-colors" do %>
      Add Employee
    <% end %>
  </div>

  <div class="flex items-center justify-between mb-4">
    <%= search_form_for @q, url: employees_path do |f| %>
      <div class="flex gap-3 items-center">
        <%= f.search_field :first_name_or_last_name_cont,
              placeholder: "Search by name…",
              class: "rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 w-72 focus:border-amber-600 focus:ring-2 focus:ring-amber-600 focus:outline-none" %>
        <%= f.submit "Search",
              class: "rounded-lg bg-amber-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-600 cursor-pointer transition-colors" %>
        <% if params.dig(:q, :first_name_or_last_name_cont).present? %>
          <%= link_to "Clear", employees_path, class: "text-sm text-neutral-500 hover:text-neutral-700" %>
        <% end %>
      </div>
    <% end %>

    <%== @pagy.series_nav %>
  </div>

  <div class="bg-white shadow-sm rounded-xl border border-neutral-200 my-4">
    <%= turbo_frame_tag "employees_list", class: "block divide-y divide-neutral-100" do %>
      <% if @employees.any? %>
        <% @employees.each do |employee| %>
          <%= render employee %>
        <% end %>
      <% else %>
        <div id="employees_empty_state" class="px-6 py-8 text-center text-sm text-neutral-500">
          No employees yet.
        </div>
      <% end %>
    <% end %>
  </div>

  <%== @pagy.series_nav %>
</div>
