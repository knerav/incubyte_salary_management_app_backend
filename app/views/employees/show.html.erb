<%= turbo_frame_tag :modal do %>
  <dialog data-controller="modal"
          data-action="click->modal#backdropClose"
          class="m-auto rounded-xl border border-neutral-200 shadow-xl p-0 w-full max-w-2xl backdrop:bg-neutral-900/50">
    <div class="px-8 py-6 max-h-[90vh] overflow-y-auto">

      <%# Header %>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-semibold text-neutral-900"><%= @employee.full_name %></h2>
        <div class="flex items-center gap-2">
          <%= link_to edit_employee_path(@employee),
                aria: { label: "Edit #{@employee.full_name}" },
                data: { turbo_frame: "modal" },
                class: "rounded-lg border border-neutral-300 p-2 text-neutral-700 hover:bg-neutral-50 transition-colors" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          <% end %>
          <%= button_to employee_path(@employee),
                method: :delete,
                class: "rounded-lg bg-red-600 p-2 text-white hover:bg-red-500 transition-colors cursor-pointer",
                data: { turbo_confirm: "Delete #{@employee.full_name}? This cannot be undone." } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          <% end %>
          <button type="button"
                  data-action="click->modal#close"
                  class="rounded-lg border border-neutral-300 p-2 text-neutral-400 hover:text-neutral-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        </div>
      </div>

      <%# Details grid %>
      <div class="bg-neutral-50 rounded-xl border border-neutral-200 divide-y divide-neutral-100 mb-6">
        <div class="grid grid-cols-2 gap-4 px-6 py-4">
          <div>
            <p class="text-xs text-neutral-500">Email</p>
            <p class="text-sm text-neutral-900"><%= @employee.email %></p>
          </div>
          <div>
            <p class="text-xs text-neutral-500">Job Title</p>
            <p class="text-sm text-neutral-900"><%= @employee.job_title.name %></p>
          </div>
          <div>
            <p class="text-xs text-neutral-500">Department</p>
            <p class="text-sm text-neutral-900"><%= @employee.department.name %></p>
          </div>
          <div>
            <p class="text-xs text-neutral-500">Country</p>
            <p class="text-sm text-neutral-900"><%= @employee.country %></p>
          </div>
          <div>
            <p class="text-xs text-neutral-500">Employment Type</p>
            <p class="text-sm text-neutral-900"><%= @employee.employment_type.humanize %></p>
          </div>
          <div>
            <p class="text-xs text-neutral-500">Hired On</p>
            <p class="text-sm text-neutral-900"><%= @employee.hired_on.strftime("%d %b %Y") %></p>
          </div>
          <div>
            <p class="text-xs text-neutral-500">Salary</p>
            <p class="text-sm text-neutral-900"><%= number_to_currency(@employee.salary, unit: @employee.currency + " ") %></p>
          </div>
        </div>
      </div>

      <%# Salary update %>
      <h3 class="text-sm font-semibold text-neutral-700 mb-3">Update Salary</h3>
      <%= form_with url: salary_employee_path(@employee), method: :patch, scope: :employee, class: "flex items-end gap-4" do |f| %>
        <div>
          <%= f.label :salary, class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= f.number_field :salary, value: @employee.salary, step: "0.01", min: "0.01",
                class: "input-field" %>
        </div>
        <div>
          <%= f.label :currency, class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= f.select :currency, currency_options, { selected: @employee.currency }, class: "select-field" %>
        </div>
        <%= f.submit "Update Salary",
              class: "rounded-lg bg-amber-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-600 cursor-pointer transition-colors" %>
      <% end %>

    </div>
  </dialog>
<% end %>
