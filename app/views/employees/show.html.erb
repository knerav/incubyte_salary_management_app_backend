<div class="max-w-3xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= @employee.full_name %></h1>
    <div class="flex items-center gap-3">
      <%= link_to "Edit", edit_employee_path(@employee),
            class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" %>
      <%= button_to "Delete", employee_path(@employee),
            method: :delete,
            class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-500 transition-colors cursor-pointer",
            data: { turbo_confirm: "Delete #{@employee.full_name}? This cannot be undone." } %>
    </div>
  </div>

  <% if notice.present? %>
    <div class="mb-4 rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-700">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-sm rounded-xl border border-gray-200 divide-y divide-gray-100">
    <div class="grid grid-cols-2 gap-4 px-6 py-4">
      <div>
        <p class="text-xs text-gray-500">Email</p>
        <p class="text-sm text-gray-900"><%= @employee.email %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Job Title</p>
        <p class="text-sm text-gray-900"><%= @employee.job_title.name %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Department</p>
        <p class="text-sm text-gray-900"><%= @employee.department %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Country</p>
        <p class="text-sm text-gray-900"><%= @employee.country %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Employment Type</p>
        <p class="text-sm text-gray-900"><%= @employee.employment_type.humanize %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Hired On</p>
        <p class="text-sm text-gray-900"><%= @employee.hired_on.strftime("%d %b %Y") %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Salary</p>
        <p class="text-sm text-gray-900"><%= number_to_currency(@employee.salary, unit: @employee.currency + " ") %></p>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Update Salary</h2>
    <div class="bg-white shadow-sm rounded-xl border border-gray-200 px-6 py-6">
      <%= form_with url: salary_employee_path(@employee), method: :patch, class: "flex items-end gap-4" do |f| %>
        <div>
          <%= f.label :salary, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :salary, value: @employee.salary, step: "0.01", min: "0.01",
                class: "rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
        </div>
        <div>
          <%= f.label :currency, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :currency, value: @employee.currency, maxlength: 3,
                class: "w-24 rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
        </div>
        <%= f.submit "Update Salary",
              class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 cursor-pointer transition-colors" %>
      <% end %>
    </div>
  </div>
</div>
