<div class="max-w-6xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-neutral-900"><%= @employee.full_name %></h1>
    <div class="flex items-center gap-3">
      <%= link_to edit_employee_path(@employee),
            aria: { label: "Edit #{@employee.full_name}" },
            data: { turbo_frame: "modal" },
            class: "rounded-lg border border-neutral-300 p-2 text-neutral-700 hover:bg-neutral-50 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
      <% end %>
      <%= button_to employee_path(@employee),
            method: :delete,
            class: "rounded-lg bg-red-600 p-2 text-white hover:bg-red-500 transition-colors cursor-pointer",
            data: { turbo_confirm: "Delete #{@employee.full_name}? This cannot be undone." } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      <% end %>
    </div>
  </div>

  <% if notice.present? %>
    <div class="mb-4 rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-700">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-sm rounded-xl border border-neutral-200 divide-y divide-neutral-100">
    <div class="grid grid-cols-2 gap-4 px-6 py-4">
      <div>
        <p class="text-xs text-neutral-500">Email</p>
        <p class="text-sm text-neutral-900"><%= @employee.email %></p>
      </div>
      <div>
        <p class="text-xs text-neutral-500">Job Title</p>
        <p class="text-sm text-neutral-900"><%= @employee.job_title.name %></p>
      </div>
      <div>
        <p class="text-xs text-neutral-500">Department</p>
        <p class="text-sm text-neutral-900"><%= @employee.department.name %></p>
      </div>
      <div>
        <p class="text-xs text-neutral-500">Country</p>
        <p class="text-sm text-neutral-900"><%= @employee.country %></p>
      </div>
      <div>
        <p class="text-xs text-neutral-500">Employment Type</p>
        <p class="text-sm text-neutral-900"><%= @employee.employment_type.humanize %></p>
      </div>
      <div>
        <p class="text-xs text-neutral-500">Hired On</p>
        <p class="text-sm text-neutral-900"><%= @employee.hired_on.strftime("%d %b %Y") %></p>
      </div>
      <div>
        <p class="text-xs text-neutral-500">Salary</p>
        <p class="text-sm text-neutral-900"><%= number_to_currency(@employee.salary, unit: @employee.currency + " ") %></p>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <h2 class="text-lg font-semibold text-neutral-900 mb-4">Update Salary</h2>
    <div class="bg-white shadow-sm rounded-xl border border-neutral-200 px-6 py-6">
      <%= form_with url: salary_employee_path(@employee), method: :patch, class: "flex items-end gap-4" do |f| %>
        <div>
          <%= f.label :salary, class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= f.number_field :salary, value: @employee.salary, step: "0.01", min: "0.01",
                class: "rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 focus:border-amber-600 focus:ring-2 focus:ring-amber-600 focus:outline-none" %>
        </div>
        <div>
          <%= f.label :currency, class: "block text-sm font-medium text-neutral-700 mb-1" %>
          <%= f.text_field :currency, value: @employee.currency, maxlength: 3,
                class: "w-24 rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 focus:border-amber-600 focus:ring-2 focus:ring-amber-600 focus:outline-none" %>
        </div>
        <%= f.submit "Update Salary",
              class: "rounded-lg bg-amber-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-600 cursor-pointer transition-colors" %>
      <% end %>
    </div>
  </div>
</div>
