<div class="mt-6 space-y-2 text-center text-sm">
  <%- if controller_name != 'sessions' %>
    <p class="text-neutral-500">
      Already have an account?
      <%= link_to "Sign in", new_session_path(resource_name), class: "font-medium text-amber-700 hover:text-amber-600" %>
    </p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p class="text-neutral-500">
      Don't have an account?
      <%= link_to "Sign up", new_registration_path(resource_name), class: "font-medium text-amber-700 hover:text-amber-600" %>
    </p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p>
      <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-neutral-500 hover:text-neutral-700" %>
    </p>
  <% end %>
</div>
