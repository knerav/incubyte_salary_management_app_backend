<div class="min-h-screen flex items-center justify-center bg-neutral-50">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-neutral-900">Welcome back</h1>
      <p class="mt-2 text-sm text-neutral-500">Sign in to your HR account</p>
    </div>

    <div class="bg-white shadow-sm rounded-xl border border-neutral-200 px-8 py-10">
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="space-y-5">
          <div>
            <%= f.label :email, class: "block text-sm font-medium text-neutral-700 mb-1" %>
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  class: "w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 placeholder-neutral-400 focus:border-amber-600 focus:ring-2 focus:ring-amber-600 focus:outline-none" %>
          </div>

          <div>
            <%= f.label :password, class: "block text-sm font-medium text-neutral-700 mb-1" %>
            <%= f.password_field :password,
                  autocomplete: "current-password",
                  class: "w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 placeholder-neutral-400 focus:border-amber-600 focus:ring-2 focus:ring-amber-600 focus:outline-none" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center gap-2">
              <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-neutral-300 text-amber-700 focus:ring-amber-600" %>
              <%= f.label :remember_me, class: "text-sm text-neutral-600" %>
            </div>
          <% end %>

          <%= f.submit "Sign in",
                class: "w-full rounded-lg bg-amber-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2 cursor-pointer transition-colors" %>
        </div>
      <% end %>
    </div>

    <%= render "devise/shared/links" %>
  </div>
</div>
