<div class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold text-neutral-900 mb-6">Salary Insights</h1>

  <%# Filters %>
  <%= form_with url: insights_path, method: :get, class: "flex items-end gap-4 mb-8" do |f| %>
    <div>
      <%= f.label :country, "Country", class: "block text-sm font-medium text-neutral-700 mb-1" %>
      <%= f.select :country,
            @countries.map { |c| [c.iso_short_name, c.alpha2] },
            { selected: @filters[:country] },
            class: "rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 focus:border-amber-600 focus:ring-2 focus:ring-amber-600 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :department_id, "Department", class: "block text-sm font-medium text-neutral-700 mb-1" %>
      <%= f.collection_select :department_id, Department.order(:name), :id, :name,
            { selected: @filters[:department_id], include_blank: "All departments" },
            class: "rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 focus:border-amber-600 focus:ring-2 focus:ring-amber-600 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :job_title_id, "Job Title", class: "block text-sm font-medium text-neutral-700 mb-1" %>
      <%= f.collection_select :job_title_id, JobTitle.order(:name), :id, :name,
            { selected: @filters[:job_title_id], include_blank: "All titles" },
            class: "rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 focus:border-amber-600 focus:ring-2 focus:ring-amber-600 focus:outline-none" %>
    </div>
    <%= f.submit "Apply", class: "rounded-lg bg-amber-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-600 cursor-pointer transition-colors" %>
  <% end %>

  <%# Summary stats %>
  <div class="grid grid-cols-4 gap-4 mb-8">
    <div class="bg-white shadow-sm rounded-xl border border-neutral-200 px-6 py-5">
      <p class="text-xs text-neutral-500 mb-1">Employees</p>
      <p class="text-2xl font-bold text-neutral-900"><%= @insights.employee_count %></p>
    </div>
    <div class="bg-white shadow-sm rounded-xl border border-neutral-200 px-6 py-5">
      <p class="text-xs text-neutral-500 mb-1">Average Salary</p>
      <p class="text-2xl font-bold text-neutral-900">
        <%= @insights.avg_salary ? "#{@currency_symbol}#{number_with_delimiter(@insights.avg_salary.round)}" : "—" %>
      </p>
    </div>
    <div class="bg-white shadow-sm rounded-xl border border-neutral-200 px-6 py-5">
      <p class="text-xs text-neutral-500 mb-1">Min Salary</p>
      <p class="text-2xl font-bold text-neutral-900">
        <%= @insights.min_salary ? "#{@currency_symbol}#{number_with_delimiter(@insights.min_salary.round)}" : "—" %>
      </p>
    </div>
    <div class="bg-white shadow-sm rounded-xl border border-neutral-200 px-6 py-5">
      <p class="text-xs text-neutral-500 mb-1">Max Salary</p>
      <p class="text-2xl font-bold text-neutral-900">
        <%= @insights.max_salary ? "#{@currency_symbol}#{number_with_delimiter(@insights.max_salary.round)}" : "—" %>
      </p>
    </div>
  </div>

  <%# Breakdown by job title %>
  <% if @insights.breakdowns.any? %>
    <div class="bg-white shadow-sm rounded-xl border border-neutral-200">
      <div class="px-6 py-4 border-b border-neutral-100">
        <h2 class="text-sm font-semibold text-neutral-700">Average Salary by Job Title</h2>
      </div>
      <div class="divide-y divide-neutral-100">
        <% @insights.breakdowns.each do |title, avg| %>
          <div class="flex items-center justify-between px-6 py-3">
            <span class="text-sm text-neutral-700"><%= title %></span>
            <span class="text-sm font-medium text-neutral-900"><%= "#{@currency_symbol}#{number_with_delimiter(avg.round)}" %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
