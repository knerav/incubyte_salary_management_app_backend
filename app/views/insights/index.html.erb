<div class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Salary Insights</h1>

  <%# Filters %>
  <%= form_with url: insights_path, method: :get, class: "flex items-end gap-4 mb-8" do |f| %>
    <div>
      <%= f.label :country, "Country", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :country, value: @filters[:country], maxlength: 2, placeholder: "e.g. US",
            class: "rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 w-28 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :department, "Department", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :department, value: @filters[:department], placeholder: "e.g. Engineering",
            class: "rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <div>
      <%= f.label :job_title_id, "Job Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :job_title_id, JobTitle.order(:name), :id, :name,
            { selected: @filters[:job_title_id], include_blank: "All titles" },
            class: "rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>
    <%= f.submit "Apply", class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500 cursor-pointer transition-colors" %>
    <% if @filters.values.any?(&:present?) %>
      <%= link_to "Clear", insights_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    <% end %>
  <% end %>

  <%# Summary stats %>
  <div class="grid grid-cols-4 gap-4 mb-8">
    <div class="bg-white shadow-sm rounded-xl border border-gray-200 px-6 py-5">
      <p class="text-xs text-gray-500 mb-1">Employees</p>
      <p class="text-2xl font-bold text-gray-900"><%= @employee_count %></p>
    </div>
    <div class="bg-white shadow-sm rounded-xl border border-gray-200 px-6 py-5">
      <p class="text-xs text-gray-500 mb-1">Average Salary</p>
      <p class="text-2xl font-bold text-gray-900">
        <%= @avg_salary ? number_with_delimiter(@avg_salary.round) : "—" %>
      </p>
    </div>
    <div class="bg-white shadow-sm rounded-xl border border-gray-200 px-6 py-5">
      <p class="text-xs text-gray-500 mb-1">Min Salary</p>
      <p class="text-2xl font-bold text-gray-900">
        <%= @min_salary ? number_with_delimiter(@min_salary.round) : "—" %>
      </p>
    </div>
    <div class="bg-white shadow-sm rounded-xl border border-gray-200 px-6 py-5">
      <p class="text-xs text-gray-500 mb-1">Max Salary</p>
      <p class="text-2xl font-bold text-gray-900">
        <%= @max_salary ? number_with_delimiter(@max_salary.round) : "—" %>
      </p>
    </div>
  </div>

  <%# Breakdown by job title %>
  <% if @breakdowns.any? %>
    <div class="bg-white shadow-sm rounded-xl border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-700">Average Salary by Job Title</h2>
      </div>
      <div class="divide-y divide-gray-100">
        <% @breakdowns.each do |title, avg| %>
          <div class="flex items-center justify-between px-6 py-3">
            <span class="text-sm text-gray-700"><%= title %></span>
            <span class="text-sm font-medium text-gray-900"><%= number_with_delimiter(avg.round) %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
