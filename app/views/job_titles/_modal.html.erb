<dialog data-controller="modal"
        data-action="click->modal#backdropClose"
        class="rounded-xl border border-gray-200 shadow-xl p-0 w-full max-w-md backdrop:bg-gray-900/50">
  <div class="px-8 py-6">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-semibold text-gray-900">New Job Title</h2>
      <button type="button"
              data-action="click->modal#close"
              class="text-gray-400 hover:text-gray-600 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
    <%= render "form", job_title: job_title, in_modal: true %>
  </div>
</dialog>
