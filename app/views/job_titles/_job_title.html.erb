<%= turbo_frame_tag dom_id(job_title) do %>
  <div class="flex items-center justify-between px-6 py-4">
    <span class="text-sm text-neutral-900"><%= job_title.name %></span>
    <div class="flex items-center gap-3">
      <%= link_to edit_job_title_path(job_title),
            aria: { label: "Edit #{job_title.name}" },
            class: "text-amber-700 hover:text-amber-600" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
      <% end %>
      <%= button_to job_title_path(job_title),
            method: :delete,
            class: "text-red-600 hover:text-red-500 bg-transparent border-0 cursor-pointer p-0",
            data: { turbo_confirm: "Delete '#{job_title.name}'? This cannot be undone." } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      <% end %>
    </div>
  </div>
<% end %>
