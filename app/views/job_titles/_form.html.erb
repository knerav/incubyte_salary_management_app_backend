<%= form_with model: job_title, class: "space-y-5" do |f| %>
  <% if job_title.errors.any? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3">
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% job_title.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-neutral-700 mb-1" %>
    <%= f.text_field :name,
          autofocus: true,
          class: "w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm text-neutral-900 placeholder-neutral-400 focus:border-amber-600 focus:ring-2 focus:ring-amber-600 focus:outline-none" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "rounded-lg bg-amber-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2 cursor-pointer transition-colors" %>
    <% if local_assigns[:in_modal] %>
      <button type="button" data-action="click->modal#close" class="text-sm text-neutral-600 hover:text-neutral-500">Cancel</button>
    <% else %>
      <%= link_to "Cancel", job_titles_path, class: "text-sm text-neutral-600 hover:text-neutral-500" %>
    <% end %>
  </div>
<% end %>
