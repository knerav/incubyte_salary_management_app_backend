<div class="max-w-3xl mx-auto px-4 py-10">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-neutral-900">Job Titles</h1>
    <%= link_to "Add Job Title", new_job_title_path,
          class: "rounded-lg bg-amber-700 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600 transition-colors" %>
  </div>

  <% if notice.present? %>
    <div class="mb-4 rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-700">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-sm rounded-xl border border-neutral-200 divide-y divide-neutral-100">
    <% if @job_titles.any? %>
      <% @job_titles.each do |job_title| %>
        <div class="flex items-center justify-between px-6 py-4">
          <span class="text-sm text-neutral-900"><%= job_title.name %></span>
          <div class="flex items-center gap-3">
            <%= link_to edit_job_title_path(job_title),
                  aria: { label: "Edit #{job_title.name}" },
                  class: "text-amber-700 hover:text-amber-600" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            <% end %>
            <%= button_to job_title_path(job_title),
                  method: :delete,
                  class: "text-red-600 hover:text-red-500 bg-transparent border-0 cursor-pointer p-0",
                  data: { turbo_confirm: "Delete '#{job_title.name}'? This cannot be undone." } do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="px-6 py-8 text-center text-sm text-neutral-500">
        No job titles yet. <%= link_to "Add one", new_job_title_path, class: "text-amber-700 hover:text-amber-600 font-medium" %>.
      </div>
    <% end %>
  </div>
</div>
