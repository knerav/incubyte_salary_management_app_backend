<div class="max-w-7xl mx-auto px-6 py-10">
  <h1 class="text-2xl font-bold text-neutral-900 mb-2">Organisation Settings</h1>
  <p class="text-sm text-neutral-500 mb-8">Manage the reference data used across employee records and insights.</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

    <%# — Job Titles ————————————————————————————————————————————————————————— %>
    <div class="bg-white rounded-xl border border-neutral-200 shadow-sm">
      <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100">
        <h2 class="text-base font-semibold text-neutral-900">Job Titles</h2>
        <%= link_to new_job_title_path,
              data: { turbo_frame: "modal" },
              class: "text-neutral-400 hover:text-amber-700 transition-colors",
              aria: { label: "Add job title" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>
      <%= turbo_frame_tag "job_titles_list", class: "block divide-y divide-neutral-100" do %>
        <% if @job_titles.any? %>
          <% @job_titles.each do |job_title| %>
            <%= render job_title %>
          <% end %>
        <% else %>
          <div id="job_titles_empty_state" class="px-6 py-8 text-center text-sm text-neutral-500">
            No job titles yet.
          </div>
        <% end %>
      <% end %>
    </div>

    <%# — Departments ————————————————————————————————————————————————————————— %>
    <div class="bg-white rounded-xl border border-neutral-200 shadow-sm">
      <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-100">
        <h2 class="text-base font-semibold text-neutral-900">Departments</h2>
        <%= link_to new_department_path,
              data: { turbo_frame: "modal" },
              class: "text-neutral-400 hover:text-amber-700 transition-colors",
              aria: { label: "Add department" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>
      <%= turbo_frame_tag "departments_list", class: "block divide-y divide-neutral-100" do %>
        <% if @departments.any? %>
          <% @departments.each do |department| %>
            <%= render department %>
          <% end %>
        <% else %>
          <div id="departments_empty_state" class="px-6 py-8 text-center text-sm text-neutral-500">
            No departments yet.
          </div>
        <% end %>
      <% end %>
    </div>

  </div>
</div>
