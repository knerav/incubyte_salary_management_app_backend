<nav class="bg-white border-b border-neutral-200">
  <div class="mx-auto max-w-7xl px-6 flex h-16 items-center justify-between">

    <%# Logo %>
    <%= link_to root_path do %>
      <%= image_tag "hrpulse_logo.png", alt: "HR pulse logo", class: "h-44" %>
    <% end %>

    <%# Nav items %>
    <div class="flex items-center gap-1">
      <%= link_to "Home", root_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium transition-colors #{current_page?(root_path) ? 'bg-amber-50 text-amber-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}" %>
      <%= link_to "Employees", employees_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium transition-colors #{current_page?(employees_path) ? 'bg-amber-50 text-amber-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}" %>
      <%= link_to "Insights", insights_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium transition-colors #{current_page?(insights_path) ? 'bg-amber-50 text-amber-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}" %>
      <%= link_to "Settings", organisation_settings_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium transition-colors #{current_page?(organisation_settings_path) ? 'bg-amber-50 text-amber-700' : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'}" %>
    </div>

    <%# Profile dropdown %>
    <div class="relative" data-controller="dropdown">
      <button type="button"
              data-action="click->dropdown#toggle click@window->dropdown#hide"
              class="flex items-center justify-center h-9 w-9 rounded-full bg-amber-50 text-amber-700 hover:bg-amber-100 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </button>

      <div data-dropdown-target="menu"
           class="hidden absolute right-0 mt-2 w-44 rounded-xl bg-white border border-neutral-200 shadow-lg py-1 z-50">
        <%= link_to "Account settings", edit_user_registration_path,
              class: "block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-50" %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
              class: "w-full text-left block px-4 py-2 text-sm text-neutral-700 hover:bg-neutral-50 bg-transparent border-0 cursor-pointer" %>
      </div>
    </div>

  </div>
</nav>
