<nav class="bg-white border-b border-gray-200">
  <div class="mx-auto max-w-7xl px-6 flex h-16 items-center justify-between">

    <%# Logo %>
    <%= link_to root_path, class: "flex items-center gap-2 text-indigo-600 font-bold text-lg tracking-tight" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Salary Manager
    <% end %>

    <%# Nav items %>
    <div class="flex items-center gap-1">
      <%= link_to "Home", root_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium transition-colors #{current_page?(root_path) ? 'bg-indigo-50 text-indigo-600' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" %>
      <%= link_to "Employees", employees_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium transition-colors #{current_page?(employees_path) ? 'bg-indigo-50 text-indigo-600' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" %>
      <%= link_to "Settings", organisation_settings_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium transition-colors #{current_page?(organisation_settings_path) ? 'bg-indigo-50 text-indigo-600' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" %>
      <%= link_to "Insights", insights_path,
            class: "rounded-lg px-4 py-2 text-sm font-medium transition-colors #{current_page?(insights_path) ? 'bg-indigo-50 text-indigo-600' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" %>
    </div>

    <%# Profile dropdown %>
    <div class="relative" data-controller="dropdown">
      <button type="button"
              data-action="click->dropdown#toggle click@window->dropdown#hide"
              class="flex items-center justify-center h-9 w-9 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </button>

      <div data-dropdown-target="menu"
           class="hidden absolute right-0 mt-2 w-44 rounded-xl bg-white border border-gray-200 shadow-lg py-1 z-50">
        <%= link_to "Account settings", edit_user_registration_path,
              class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
              class: "w-full text-left block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 bg-transparent border-0 cursor-pointer" %>
      </div>
    </div>

  </div>
</nav>
